# ==============================================================================
# RepoMind — Environment Variables Configuration
# ==============================================================================

# Database Connection (PostgreSQL with PGVector)
DATABASE_URL=jdbc:postgresql://localhost:5432/repomind
DATABASE_USERNAME=repomind
DATABASE_PASSWORD=repomind

# Security & JWT Authentication
# HS256 secret key (minimum 256 bits / 32 characters)
JWT_SECRET=repomind-production-super-secret-key-change-in-production-2026-min-32-chars

# Google Gemini AI Key (Optional)
# If left empty, RepoMind operates in deterministic Demo Intelligence Mode with grounded citations
GEMINI_API_KEY=

# GitHub OAuth Integration (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Application Mode
# Set to 'true' to pre-load demo repository on startup
DEMO_MODE=true

# URLs and Ports
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
